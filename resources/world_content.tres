[resource]
script = ExtResource("s_content")
guilds = Array[ExtResource("s_guild")]([ExtResource("g_ore_outcrops"), ExtResource("g_surface_rocks"), ExtResource("g_canopy_trees"), ExtResource("g_wetland_plants"), ExtResource("g_shore_features"), ExtResource("g_deadwood"), ExtResource("g_shrubs"), ExtResource("g_desert_plants"), ExtResource("g_pioneer_plants"), ExtResource("g_ground_cover")])
world_view_layers = Array[ExtResource("s_layer")]([SubResource("layer_ore_outcrops"), SubResource("layer_surface_rocks"), SubResource("layer_wetland_plants"), SubResource("layer_shore_features"), SubResource("layer_ground_cover"), SubResource("layer_pioneer_plants"), SubResource("layer_deadwood"), SubResource("layer_desert_plants"), SubResource("layer_shrubs"), SubResource("layer_canopy_trees")])
deposits = Array[ExtResource("s_def")]([ExtResource("d_iron"), ExtResource("d_copper"), ExtResource("d_coal"), ExtResource("d_clay"), ExtResource("d_salt")])
farmland = ExtResource("farmland")
oak = ExtResource("oak")
terrain_materials = Array[ExtResource("s_mat")]([ExtResource("m_grass"), ExtResource("m_dry_grass"), ExtResource("m_dirt"), ExtResource("m_forest_floor"), ExtResource("m_mud"), ExtResource("m_marsh"), ExtResource("m_sand"), ExtResource("m_beach_sand"), ExtResource("m_gravel"), ExtResource("m_rock"), ExtResource("m_snow"), ExtResource("m_burnt_ground")])
terrain_fallback = ExtResource("m_dirt")
structures = Array[ExtResource("s_struct")]([ExtResource("s_camp"), ExtResource("s_standing_stones"), ExtResource("s_ruins")])
